# Profile for Yahboom ROS-WiFi camera module (separate ESP32-S3).
# Build: ./scripts/flash_camera_firmware.sh
# Agent port 9999 is Yahboom standard (drive board uses 8090).

CONFIG_ROVER_ENABLE_CAMERA=y
CONFIG_ROVER_CAMERA_ONLY=y

CONFIG_MICRO_ROS_DOMAIN_ID=20
CONFIG_MICRO_ROS_AGENT_IP="10.0.0.29"
CONFIG_MICRO_ROS_AGENT_PORT="9999"
CONFIG_ESP_WIFI_SSID=""
CONFIG_ESP_WIFI_PASSWORD=""

# PSRAM when present (N16R8 camera modules). Boards without PSRAM still boot
# via SPIRAM_IGNORE_NOTFOUND.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_ROVER_CAMERA_PERIOD_MS=200
CONFIG_ROVER_CAMERA_MAX_JPEG_BYTES=32768
CONFIG_MICRO_ROS_APP_STACK=20000
