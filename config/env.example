# Copy to config/env and customize (config/env is gitignored).
#
# ROS_DOMAIN_ID must match on PC, Docker agent, and ESP firmware.

export ROS_DOMAIN_ID=20

# UDP micro-ROS agent (PC side). ESP firmware must use the same IP + port.
export MICRO_ROS_AGENT_PORT=8090

# Your PC's LAN IP as seen by the robot on Wi-Fi.
# VMware example: 10.0.0.217
# WSL: usually your Windows Wi-Fi IP from `ipconfig`, NOT the 172.x WSL address.
export MICRO_ROS_AGENT_IP=10.0.0.217

# Optional: Wi-Fi SSID notes (actual credentials are in ESP sdkconfig / menuconfig)
# export ESP_WIFI_SSID=your_wifi
